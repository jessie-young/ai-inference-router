# API key for the OpenRouter upstream. Referenced by config.yaml as `api_key_env`.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: if set, clients must send `Authorization: Bearer <this>` to use the
# router. Leave unset for local development.
# ROUTER_API_KEY=

# Optional overrides
# PORT=8080
# HOST=0.0.0.0
# LOG_LEVEL=info
